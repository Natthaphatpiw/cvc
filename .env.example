# ─────────────────────────────────────────────────────────────────────────────
# CVC KOL Matcher — environment
# Local dev: copy to `.env` at the repo root. All three apps read this one file
# (next.config.ts → loadEnvConfig(repoRoot)).
# On Vercel: set each variable only in the project(s) named in its section header.
# Leave a secret empty to run that part in demo mode (fictional data, labelled as demo in the UI).
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared · web + api + agent ───────────────────────────────────────────────
# Random 32+ bytes (openssl rand -hex 32). web's proxy.ts adds it as x-cvc-edge; api/agent reject requests without it.
EDGE_SHARED_SECRET=
# auto = mock providers + stub AI for anything whose key is missing · on = always demo · off = fail if keys are missing
DEMO_MODE=auto

# ── Vercel · api + agent (service-to-service OIDC) ───────────────────────────
# Team slug from vercel.com/<team-slug>. OIDC: iss=https://oidc.vercel.com/<slug>, sub=owner:<slug>:project:<name>:environment:<env>
VERCEL_TEAM_SLUG=
VERCEL_PROJECT_WEB=cvc-web
VERCEL_PROJECT_API=cvc-api
VERCEL_PROJECT_AGENT=cvc-agent
# Local only: `vercel env pull` writes a short-lived token here. On Vercel it is injected per request.
VERCEL_OIDC_TOKEN=
# Vercel → Project → Settings → Deployment Protection → Protection Bypass for Automation (same value in all 3 projects)
PREVIEW_BYPASS_SECRET=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` (api + agent)
CRON_SECRET=

# ── web (cvc-web) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where proxy.ts forwards /api/* and /api/agent/*. On Vercel, related projects override these for previews.
API_ORIGIN=http://localhost:3001
AGENT_ORIGIN=http://localhost:3002
# Supabase → Project Settings → API Keys (publishable key: sb_publishable_…)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# LINE Developers → LINE Login channel → LIFF → LIFF ID (e.g. 1650000000-AbCdEfGh). Endpoint URL = https://<domain>/liff
NEXT_PUBLIC_LIFF_ID=
# LINE Official Account basic ID (with @) for the add-friend link; optional
NEXT_PUBLIC_LINE_OA_BASIC_ID=
# Bump when the privacy notice text changes; users re-acknowledge
NEXT_PUBLIC_NOTICE_VERSION=2026-10-21

# ── Supabase · api + agent ───────────────────────────────────────────────────
# Same value as NEXT_PUBLIC_SUPABASE_URL. Used for JWKS (JWT verify) and admin auth calls.
SUPABASE_URL=
# Secret key (sb_secret_…) — api only. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Postgres via Supavisor transaction pooler (:6543), one DB role per service (see supabase/migrations, set passwords with
#   alter role svc_api password '…'; alter role svc_agent password '…';)
# Format: postgres://svc_api.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Local supabase start: postgres://svc_api:<password>@127.0.0.1:54322/postgres
API_DATABASE_URL=
AGENT_DATABASE_URL=

# ── LINE · api ───────────────────────────────────────────────────────────────
# LINE Login channel (the one that owns the LIFF app) → Basic settings
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Messaging API channel (LINE OA) → Basic settings → Channel secret / Messaging API → Channel access token (long-lived)
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# ── Redis (Upstash via Vercel Marketplace) · api + agent ─────────────────────
# The Marketplace may inject KV_REST_API_URL / KV_REST_API_TOKEN instead; @cvc/cache reads either pair.
# Empty = in-memory fallback (single process, dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Job queue · Upstash QStash / Workflow · agent ────────────────────────────
# POST /api/agent/runs only enqueues the run (202). QStash then calls /api/workflow/kol-match once per step, each step in
# its own function invocation, so no request waits for the whole pipeline. agent only: never set these in web or api.
# Upstash Console → QStash (pick a region; token in Quickstart, keys under Signing keys), or Vercel Marketplace →
# "Upstash QStash/Workflow" connected to cvc-agent (run `vercel env pull` to check which names it injected).
# Local queue: run `npm run qstash:dev` next to `npm run dev`. It prints a local QSTASH_TOKEN and both signing keys
# (valid for the dev server only); then set QSTASH_URL=http://127.0.0.1:8080 and UPSTASH_WORKFLOW_URL=http://localhost:3002.
QSTASH_TOKEN=
# Empty = Upstash cloud default (EU, https://qstash.upstash.io). US region: https://qstash-us-east-1.upstash.io
# (token and signing keys are per region). Local dev server: http://127.0.0.1:8080
QSTASH_URL=
# The workflow endpoint verifies every QStash call with these keys. Without both it does not verify signatures.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public origin of cvc-agent that QStash calls (no path), e.g. https://cvc-agent.vercel.app · local http://localhost:3002
# On Vercel it is optional; if set, scope it to Production only. Empty = https://$VERCEL_PROJECT_PRODUCTION_URL in
# production, https://$VERCEL_URL in preview (passes Deployment Protection with VERCEL_AUTOMATION_BYPASS_SECRET,
# which Vercel injects itself once Protection Bypass for Automation has a secret).
UPSTASH_WORKFLOW_URL=
# auto = the queue when QSTASH_TOKEN is set, otherwise inline outside production (production without QStash answers
# 503 queue_not_configured) · upstash = always the queue · inline = in-process after the response (local/tests only)
PIPELINE_RUNNER=auto
# How many analysis runs QStash works on at once (flow control parallelism, key cvc-kol-match); the rest wait in the queue
PIPELINE_MAX_PARALLEL_RUNS=3

# ── Vercel Blob · two stores (connect each with a custom env prefix) ─────────
# Private store (uploads/, raw/) — api + agent. Prefix "BLOB_PRIVATE" → BLOB_PRIVATE_READ_WRITE_TOKEN
BLOB_PRIVATE_READ_WRITE_TOKEN=
# Public store (creator-media/ avatars + covers) — agent. Prefix "CREATOR_MEDIA_BLOB" → CREATOR_MEDIA_BLOB_READ_WRITE_TOKEN
CREATOR_MEDIA_BLOB_READ_WRITE_TOKEN=

# ── OpenAI / AI Gateway · agent ──────────────────────────────────────────────
OPENAI_API_KEY=
# Optional: route text models through Vercel AI Gateway (on Vercel it authenticates with OIDC; locally set the key)
USE_AI_GATEWAY=false
AI_GATEWAY_API_KEY=
OPENAI_MODEL_MAIN=gpt-6.1-sol
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536

# ── Data providers · agent ───────────────────────────────────────────────────
# ScrapeCreators (TikTok search/profile/videos/comments, TikTok Shop)
SCRAPECREATORS_API_KEY=
# Apify (Facebook page + posts). Webhook URL: https://<domain>/api/agent/webhooks/apify?secret=$APIFY_WEBHOOK_SECRET
APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=
# Firecrawl (website crawl ≤ 5 pages)
FIRECRAWL_API_KEY=
# Phase 2
YOUTUBE_API_KEY=
SUPADATA_API_KEY=

# ── Cost guard · agent ───────────────────────────────────────────────────────
BUDGET_SOFT_USD=4
BUDGET_HARD_USD=6

# ── Observability · agent (optional) ─────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
